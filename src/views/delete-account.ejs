<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete Account - Gondaliya Family</title>
    <meta name="description" content="Delete your Gondaliya Family app account permanently. All your data including profile, family members, listings, and chat history will be removed.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-primary: #0a0e1a;
            --bg-secondary: #111827;
            --bg-card: #1a1f35;
            --bg-card-hover: #1e2440;
            --border-color: rgba(255, 255, 255, 0.06);
            --border-active: rgba(239, 68, 68, 0.4);
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-red: #ef4444;
            --accent-red-glow: rgba(239, 68, 68, 0.15);
            --accent-red-hover: #dc2626;
            --accent-amber: #f59e0b;
            --accent-green: #10b981;
            --gradient-red: linear-gradient(135deg, #ef4444 0%, #dc2626 50%, #b91c1c 100%);
            --gradient-bg: linear-gradient(135deg, #0a0e1a 0%, #111827 50%, #0f172a 100%);
            --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.5);
            --shadow-red: 0 8px 32px rgba(239, 68, 68, 0.2);
            --radius: 16px;
            --radius-sm: 10px;
            --radius-xs: 8px;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--gradient-bg);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
        }

        /* Animated background orbs */
        body::before,
        body::after {
            content: '';
            position: fixed;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.08;
            z-index: 0;
            pointer-events: none;
        }
        body::before {
            width: 500px;
            height: 500px;
            background: var(--accent-red);
            top: -150px;
            right: -100px;
            animation: floatOrb 20s ease-in-out infinite;
        }
        body::after {
            width: 400px;
            height: 400px;
            background: #6366f1;
            bottom: -100px;
            left: -100px;
            animation: floatOrb 25s ease-in-out infinite reverse;
        }

        @keyframes floatOrb {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -30px) scale(1.05); }
            66% { transform: translate(-20px, 20px) scale(0.95); }
        }

        /* Header */
        .header {
            width: 100%;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 10;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-logo {
            width: 42px;
            height: 42px;
            background: var(--gradient-red);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 800;
            color: white;
            box-shadow: 0 4px 16px rgba(239, 68, 68, 0.3);
        }

        .header-title {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .header-title span {
            color: var(--text-muted);
            font-weight: 400;
            font-size: 13px;
            display: block;
            margin-top: 1px;
        }

        /* Main container */
        .container {
            width: 100%;
            max-width: 480px;
            padding: 0 20px 40px;
            position: relative;
            z-index: 10;
        }

        /* Alert banner */
        .alert-banner {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: var(--radius);
            padding: 16px 18px;
            margin-bottom: 28px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            animation: slideDown 0.5s ease-out;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .alert-icon {
            width: 36px;
            height: 36px;
            background: rgba(239, 68, 68, 0.15);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 18px;
        }

        .alert-text {
            font-size: 13px;
            line-height: 1.6;
            color: var(--text-secondary);
        }

        .alert-text strong {
            color: var(--accent-red);
            font-weight: 600;
        }

        /* Card */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 28px 24px;
            box-shadow: var(--shadow-lg);
            animation: fadeUp 0.6s ease-out 0.1s both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .card-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 16px;
            background: var(--accent-red-glow);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .card-icon::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid rgba(239, 68, 68, 0.15);
            animation: pulseRing 2s ease-in-out infinite;
        }

        @keyframes pulseRing {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.08); opacity: 0.5; }
        }

        .card-icon svg {
            width: 28px;
            height: 28px;
            color: var(--accent-red);
        }

        .card-title {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .card-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            line-height: 1.5;
        }

        /* Data info */
        .data-info {
            margin-bottom: 24px;
            padding: 16px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }

        .data-info-title {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        .data-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
            font-size: 13px;
            color: var(--text-secondary);
        }

        .data-item + .data-item {
            border-top: 1px solid var(--border-color);
        }

        .data-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent-red);
            flex-shrink: 0;
        }

        /* Form */
        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 8px;
            letter-spacing: 0.2px;
        }

        .form-input {
            width: 100%;
            padding: 14px 16px;
            background: var(--bg-secondary);
            border: 1.5px solid var(--border-color);
            border-radius: var(--radius-xs);
            color: var(--text-primary);
            font-family: inherit;
            font-size: 15px;
            transition: all 0.25s ease;
            outline: none;
        }

        .form-input::placeholder {
            color: var(--text-muted);
        }

        .form-input:focus {
            border-color: var(--accent-red);
            box-shadow: 0 0 0 3px var(--accent-red-glow);
            background: var(--bg-card-hover);
        }

        .form-input.error {
            border-color: var(--accent-red);
            animation: shake 0.4s ease;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }

        .form-hint {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 6px;
            line-height: 1.4;
        }

        .form-error {
            font-size: 12px;
            color: var(--accent-red);
            margin-top: 6px;
            display: none;
            align-items: center;
            gap: 4px;
        }

        .form-error.visible {
            display: flex;
        }

        /* Checkbox */
        .checkbox-group {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 24px;
            padding: 14px 16px;
            background: rgba(239, 68, 68, 0.04);
            border-radius: var(--radius-xs);
            border: 1px solid rgba(239, 68, 68, 0.1);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .checkbox-group:hover {
            background: rgba(239, 68, 68, 0.07);
        }

        .checkbox-input {
            display: none;
        }

        .checkbox-custom {
            width: 20px;
            height: 20px;
            border: 2px solid var(--text-muted);
            border-radius: 5px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            margin-top: 1px;
        }

        .checkbox-input:checked + .checkbox-custom {
            background: var(--accent-red);
            border-color: var(--accent-red);
        }

        .checkbox-input:checked + .checkbox-custom svg {
            opacity: 1;
            transform: scale(1);
        }

        .checkbox-custom svg {
            width: 12px;
            height: 12px;
            color: white;
            opacity: 0;
            transform: scale(0.5);
            transition: all 0.2s ease;
        }

        .checkbox-text {
            font-size: 13px;
            line-height: 1.5;
            color: var(--text-secondary);
        }

        /* Delete Button */
        .btn-delete {
            width: 100%;
            padding: 16px;
            background: var(--gradient-red);
            color: white;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            border: none;
            border-radius: var(--radius-xs);
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.3px;
        }

        .btn-delete::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, transparent 0%, rgba(255,255,255,0.1) 50%, transparent 100%);
            transform: translateX(-100%);
            transition: transform 0.5s ease;
        }

        .btn-delete:hover::before {
            transform: translateX(100%);
        }

        .btn-delete:hover {
            box-shadow: var(--shadow-red);
            transform: translateY(-1px);
        }

        .btn-delete:active {
            transform: translateY(0);
        }

        .btn-delete:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .btn-delete:disabled::before {
            display: none;
        }

        .btn-text { position: relative; z-index: 1; }

        /* Spinner */
        .spinner {
            display: none;
            width: 20px;
            height: 20px;
            border: 2.5px solid rgba(255, 255, 255, 0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            margin: 0 auto;
        }

        .btn-delete.loading .btn-text { display: none; }
        .btn-delete.loading .spinner { display: inline-block; }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Result Overlays */
        .result-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(10, 14, 26, 0.92);
            backdrop-filter: blur(12px);
            z-index: 100;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .result-overlay.visible {
            display: flex;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .result-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 36px 28px;
            max-width: 400px;
            width: 100%;
            text-align: center;
            animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        @keyframes scaleIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }

        .result-icon {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .result-icon.success {
            background: rgba(16, 185, 129, 0.12);
        }

        .result-icon.error {
            background: rgba(239, 68, 68, 0.12);
        }

        .result-icon svg {
            width: 32px;
            height: 32px;
        }

        .result-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.3px;
        }

        .result-message {
            font-size: 14px;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .btn-close {
            display: inline-block;
            padding: 12px 32px;
            background: var(--bg-secondary);
            color: var(--text-primary);
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-xs);
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-close:hover {
            background: var(--bg-card-hover);
            border-color: rgba(255, 255, 255, 0.12);
        }

        /* Footer */
        .footer {
            margin-top: auto;
            padding: 24px;
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            position: relative;
            z-index: 10;
        }

        .footer a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .footer a:hover {
            color: var(--text-primary);
        }

        /* Mobile responsive */
        @media (max-width: 480px) {
            .container { padding: 0 16px 32px; }
            .card { padding: 24px 20px; }
            .card-title { font-size: 20px; }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <div class="header-brand">
            <div class="header-logo">G</div>
            <div class="header-title">
                Gondaliya Family
                <span>Account Deletion</span>
            </div>
        </div>
    </div>

    <!-- Main -->
    <div class="container">
        <!-- Alert Banner -->
        <div class="alert-banner">
            <div class="alert-icon">⚠️</div>
            <div class="alert-text">
                <strong>Warning:</strong> This action is irreversible. Your account, profile data, family members, chats, listings, and all associated data will be permanently deleted.
            </div>
        </div>

        <!-- Card -->
        <div class="card">
            <div class="card-header">
                <div class="card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                </div>
                <h1 class="card-title">Delete Your Account</h1>
                <p class="card-subtitle">Permanently delete your account and all associated data</p>
            </div>

            <!-- Data that will be deleted -->
            <div class="data-info">
                <div class="data-info-title">Following data will be permanently deleted</div>
                <div class="data-item"><span class="data-dot"></span> Profile & Personal Information</div>
                <div class="data-item"><span class="data-dot"></span> Family Members & Linked Accounts</div>
                <div class="data-item"><span class="data-dot"></span> Chat Messages & Media</div>
                <div class="data-item"><span class="data-dot"></span> Listings (Rent / Buy / Sell)</div>
                <div class="data-item"><span class="data-dot"></span> Inquiries, Feedback & Notifications</div>
            </div>

            <!-- Form -->
            <form id="deleteForm" novalidate>
                <div class="form-group">
                    <label class="form-label" for="phoneNumber">Phone Number</label>
                    <input class="form-input" type="tel" id="phoneNumber" name="phoneNumber" 
                           placeholder="10 digit mobile number" maxlength="10" autocomplete="off" required>
                    <div class="form-error" id="phoneError">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        <span id="phoneErrorText">Please enter a valid 10-digit phone number</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">Password</label>
                    <input class="form-input" type="password" id="password" name="password" 
                           placeholder="Enter your password" autocomplete="off" required>
                    <div class="form-error" id="passwordError">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        <span id="passwordErrorText">Please enter your password</span>
                    </div>
                </div>

                <label class="checkbox-group" for="confirmCheck">
                    <input type="checkbox" class="checkbox-input" id="confirmCheck">
                    <span class="checkbox-custom">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </span>
                    <span class="checkbox-text">
                        I understand that my account and all data will be <strong>permanently</strong> deleted and this action cannot be undone.
                    </span>
                </label>

                <button type="submit" class="btn-delete" id="deleteBtn" disabled>
                    <span class="btn-text">🗑️ Delete My Account Permanently</span>
                    <span class="spinner"></span>
                </button>
            </form>
        </div>
    </div>

    <!-- Success Overlay -->
    <div class="result-overlay" id="successOverlay">
        <div class="result-card">
            <div class="result-icon success">
                <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <h2 class="result-title">Account Deleted</h2>
            <p class="result-message">
                Your account has been successfully deleted. All your data has been permanently removed.
                <br><br>Thank you for being a part of the Gondaliya Family. 🙏
            </p>
        </div>
    </div>

    <!-- Error Overlay -->
    <div class="result-overlay" id="errorOverlay">
        <div class="result-card">
            <div class="result-icon error">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <h2 class="result-title">Deletion Failed</h2>
            <p class="result-message" id="errorMessage">
                Something went wrong. Please try again.
            </p>
            <button class="btn-close" onclick="closeError()">Try Again</button>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        <p>&copy; <%= new Date().getFullYear() %> Gondaliya Family. All rights reserved.</p>
    </div>

    <script>
        const phoneInput = document.getElementById('phoneNumber');
        const passwordInput = document.getElementById('password');
        const confirmCheck = document.getElementById('confirmCheck');
        const deleteBtn = document.getElementById('deleteBtn');
        const deleteForm = document.getElementById('deleteForm');
        const phoneError = document.getElementById('phoneError');
        const passwordError = document.getElementById('passwordError');
        const successOverlay = document.getElementById('successOverlay');
        const errorOverlay = document.getElementById('errorOverlay');
        const errorMessage = document.getElementById('errorMessage');

        // Only allow digits in phone input
        phoneInput.addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 10);
            validateForm();
        });

        passwordInput.addEventListener('input', validateForm);
        confirmCheck.addEventListener('change', validateForm);

        function validateForm() {
            const phoneValid = phoneInput.value.length === 10;
            const passwordValid = passwordInput.value.length > 0;
            const confirmed = confirmCheck.checked;

            // Clear errors on valid input
            if (phoneValid) {
                phoneInput.classList.remove('error');
                phoneError.classList.remove('visible');
            }
            if (passwordValid) {
                passwordInput.classList.remove('error');
                passwordError.classList.remove('visible');
            }

            deleteBtn.disabled = !(phoneValid && passwordValid && confirmed);
        }

        deleteForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            // Final validation
            let hasError = false;
            if (phoneInput.value.length !== 10) {
                phoneInput.classList.add('error');
                phoneError.classList.add('visible');
                hasError = true;
            }
            if (!passwordInput.value) {
                passwordInput.classList.add('error');
                passwordError.classList.add('visible');
                hasError = true;
            }
            if (!confirmCheck.checked) {
                hasError = true;
            }
            if (hasError) return;

            // Start loading
            deleteBtn.classList.add('loading');
            deleteBtn.disabled = true;

            try {
                const response = await fetch(window.location.pathname, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        phoneNumber: phoneInput.value,
                        password: passwordInput.value
                    })
                });

                const data = await response.json();

                if (response.ok && data.status === 200) {
                    successOverlay.classList.add('visible');
                } else {
                    errorMessage.textContent = data.message || 'Something went wrong. Please try again.';
                    errorOverlay.classList.add('visible');
                }
            } catch (err) {
                errorMessage.textContent = 'Network error. Please check your connection and try again.';
                errorOverlay.classList.add('visible');
            } finally {
                deleteBtn.classList.remove('loading');
                deleteBtn.disabled = false;
                validateForm();
            }
        });

        function closeError() {
            errorOverlay.classList.remove('visible');
        }
    </script>
